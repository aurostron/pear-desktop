{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "global-shortcut:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-open-settings-window",
    "allow-open-bl-settings-window",
    "allow-app-minimize",
    "allow-app-toggle-maximize",
    "allow-app-start-drag",
    "allow-app-close",
    "allow-diag-log",
    "allow-diag-read",
    "allow-diag-clear"
  ],
  "remote": {
    "urls": [
      "https://music.youtube.com/*",
      "https://accounts.google.com/*"
    ]
  }
}
